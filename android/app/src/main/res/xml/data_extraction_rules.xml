<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup and no device-to-device transfer of app data (it holds a login session). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
    </device-transfer>
</data-extraction-rules>
